{
  "name": "local-notebook",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "concurrently \"pnpm --filter web dev\" \"pnpm --filter desktop start\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "husky": "^9.0.0"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx}": [
      "pnpm --filter web lint"
    ],
    "web/**/*.{ts,vue}": [
      "pnpm --filter web lint"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "yarn"
    ]
  }
}